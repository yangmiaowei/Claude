# Claude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
CLAUDE_HOST=127.0.0.1
CLAUDE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
CLAUDE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
CLAUDE_LOG_FILE=~/.claude/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
CLAUDE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# CLAUDE_CONFIG=~/.claude/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_LLM_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_STEPS=20
